# Backend API URL
VITE_API_URL=http://localhost:6388/api

# OpenRouter API Key (for AI features)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Payments
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# Dev only: browse the site against a remote API without running the backend
# locally. Set both lines, then `npm start` proxies /api to that host.
# Never used by `npm run build`.
# VITE_API_URL=/api
# VITE_DEV_API_PROXY=https://imraphael.com
