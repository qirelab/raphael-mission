# Server
NODE_ENV=production
PORT=5000

# Database (PostgreSQL on VPS)
# Local: postgresql://raphael_user:password@localhost:5432/raphael_db
# Remote: postgresql://raphael_user:password@your-vps-ip:5432/raphael_db
DATABASE_URL=postgresql://raphael_user:password@localhost:5432/raphael_db

# JWT
JWT_SECRET=generate-random-32-char-string-change-in-production
JWT_EXPIRES_IN=24h

# Redis
REDIS_URL=redis://localhost:6379

# CORS
FRONTEND_URL=http://localhost:4028
ALLOWED_ORIGINS=http://localhost:4028,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# Cache
CACHE_TTL_MS=300000

# Logging
LOG_LEVEL=info
